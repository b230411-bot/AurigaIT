generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Medicine {
  id               Int      @id @default(autoincrement())
  name             String
  category         String?
  description      String?
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  batches          Batch[]
}

model Batch {
  id            Int      @id @default(autoincrement())
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  price         Float
  status        String   @default("ACTIVE")
  quarantinedAt DateTime?
  createdAt     DateTime @default(now())

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([expiryDate])
}

model Outbox {
  id        Int      @id @default(autoincrement())
  type      String
  payload   String
  createdAt DateTime @default(now())
  sent      Boolean  @default(false)
}